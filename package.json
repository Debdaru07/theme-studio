{
  "name": "dynamic-theming-system",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "sdks/*"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:server": "npm run dev -w @dts/server",
    "dev:admin": "npm run dev -w @dts/admin",
    "seed": "npm run seed -w @dts/server",
    "fixtures": "npm run fixtures -w @debdaru07/schema",
    "audit:ui": "node .claude/skills/functional-ui/scripts/audit.mjs",
    "perf:editor": "node .claude/skills/functional-ui/scripts/perf.mjs",
    "dev:site": "npm run dev -w @dts/site"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "playwright-core": "^1.63.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0"
  },
  "engines": {
    "node": ">=22.13"
  },
  "overrides": {
    "postcss-selector-parser": "^7.1.6",
    "sharp": "^0.35.5"
  },
  "license": "AGPL-3.0-only"
}
