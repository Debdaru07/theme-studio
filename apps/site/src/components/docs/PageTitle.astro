---
/**
 * Docs page header (overrides Starlight's PageTitle): section eyebrow from the sidebar group, the title, the
 * frontmatter `description` as a lead, and "Copy page", which copies the page's Markdown (served at `/<slug>.md`)
 * for pasting into an AI assistant or an issue.
 */
import type { StarlightRouteData } from '@astrojs/starlight/route-data';

type SidebarEntry = StarlightRouteData['sidebar'][number];
const { entry, sidebar } = Astro.locals.starlightRoute;

/** Label of the top-level sidebar group that contains the current page. */
function sectionOf(entries: SidebarEntry[], group?: string): string | undefined {
  for (const e of entries) {
    if (e.type === 'link' && e.isCurrent) return group;
    if (e.type === 'group') {
      const found = sectionOf(e.entries, group ?? e.label);
      if (found) return found;
    }
  }
  return undefined;
}
const section = sectionOf(sidebar);
const markdownUrl = `/${entry.id}.md`;
---

<div class="page-head">
  {section && section !== entry.data.title && <p class="page-eyebrow">{section}</p>}
  <h1 id="_top">{entry.data.title}</h1>
  {entry.data.description && <p class="page-lead">{entry.data.description}</p>}
  <copy-page class="page-actions" data-src={markdownUrl}>
    <button type="button" class="page-action">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"
        stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="8" y="8" width="12" height="12" rx="2"></rect>
        <path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"></path>
      </svg>
      <span data-label>Copy page</span>
    </button>
    <span class="sr-only" role="status" aria-live="polite" data-status></span>
  </copy-page>
</div>

<script>
  class CopyPage extends HTMLElement {
    connectedCallback() {
      const button = this.querySelector('button');
      const label = this.querySelector('[data-label]');
      const status = this.querySelector('[data-status]');
      if (!button || !label || !status) return;
      button.addEventListener('click', async () => {
        try {
          const res = await fetch(this.dataset.src ?? '');
          if (!res.ok) throw new Error(String(res.status));
          await navigator.clipboard.writeText(await res.text());
          label.textContent = 'Copied';
          status.textContent = 'Page copied as Markdown';
        } catch {
          label.textContent = 'Copy failed';
          status.textContent = 'Could not copy the page. Try again.';
        }
        setTimeout(() => (label.textContent = 'Copy page'), 1800);
      });
    }
  }
  customElements.define('copy-page', CopyPage);
</script>
