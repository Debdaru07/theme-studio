// Cloudflare Workers static-assets deploy for the docs site.
// Build first (`npm run build -w @dts/site`), then: npx wrangler deploy --config apps/site/wrangler.jsonc
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "theme-studio-docs",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
