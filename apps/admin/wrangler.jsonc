// Cloudflare Workers static-assets deploy for Theme Studio.
// Build first (`npm run build -w @dts/admin`), then: npx wrangler deploy --config apps/admin/wrangler.jsonc
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "theme-studio",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // Client-side routes (/clients/:id/theme) fall back to index.html.
    "not_found_handling": "single-page-application"
  }
}
