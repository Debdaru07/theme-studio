// Cloudflare Workers (static assets) config for Theme Studio, at the repo root so Workers Builds finds it
// with the default deploy command. Build first: npm run build -w @dts/admin
// The docs site deploys with its own config: npx wrangler deploy --config apps/site/wrangler.jsonc
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "theme-studio",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./apps/admin/dist",
    // Client-side routes (/clients/:id/theme) fall back to index.html.
    "not_found_handling": "single-page-application"
  }
}
